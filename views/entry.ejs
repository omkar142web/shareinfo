<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= entry.name %> - ShareInfo</title>
  <meta name="description" content="<%= String(entry.info || '').slice(0, 150) %>" />
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;600;700;800&family=DM+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/highlight.js@11.11.1/styles/github-dark.min.css" />
  <link rel="stylesheet" href="/css/markdown-content.css" />
  <style>
    :root {
      --bg: #0d1628;
      --surface: rgba(22, 34, 58, 0.86);
      --surface-1: rgba(22, 34, 58, 0.86);
      --surface-2: rgba(30, 46, 74, 0.62);
      --text: #f0f6ff;
      --text-2: #a8bdd4;
      --text-3: #607a96;
      --cyan: #38bdf8;
      --cyan-faint: rgba(56, 189, 248, 0.1);
      --cyan-border: rgba(56, 189, 248, 0.28);
      --cyan-glow: rgba(56, 189, 248, 0.22);
      --success: #34d399;
      --success-faint: rgba(52, 211, 153, 0.1);
      --success-border: rgba(52, 211, 153, 0.22);
      --danger: #f87171;
      --danger-faint: rgba(248, 113, 113, 0.1);
      --border: rgba(255, 255, 255, 0.12);
      --border-md: rgba(255, 255, 255, 0.13);
      --border-hi: rgba(255, 255, 255, 0.2);
      --shadow-card: 0 0 0 1px var(--border), 0 8px 40px rgba(0, 0, 0, 0.55), 0 2px 8px rgba(0, 0, 0, 0.3);
      --font-display: "Sora", system-ui, sans-serif;
      --font-body: "DM Sans", system-ui, sans-serif;
      --font-mono: "JetBrains Mono", monospace;
      --radius: 18px;
      --z-toast: 60;
      --radius-sm: 10px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      min-height: 100vh;
      font-family: var(--font-body);
      background:
        radial-gradient(circle at 16% 8%, rgba(56, 189, 248, 0.14), transparent 28rem),
        radial-gradient(circle at 82% 18%, rgba(139, 92, 246, 0.08), transparent 24rem),
        linear-gradient(180deg, #0d1628 0%, #09111f 100%);
      color: var(--text);
      /* padding: 32px 24px; */
      padding: 32px 0px;
      overflow-x: hidden;
    }

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      background-image:
        linear-gradient(rgba(255, 255, 255, 0.024) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.024) 1px, transparent 1px);
      background-size: 42px 42px;
      pointer-events: none;
    }

    body::after {
      content: "";
      position: fixed;
      inset: 0;
      background:
        radial-gradient(circle at 10% 24%, rgba(56, 189, 248, 0.09), transparent 18rem),
        radial-gradient(circle at 88% 78%, rgba(52, 211, 153, 0.08), transparent 20rem),
        radial-gradient(circle at 72% 10%, rgba(139, 92, 246, 0.08), transparent 18rem);
      filter: blur(12px);
      pointer-events: none;
    }

    .shell {
      position: relative;
      /* width: min(760px, 100%); */
      width: min(820px, 100%);
      margin: 0 auto;
      padding: 28px 0 60px;
      isolation: isolate;
    }

    .topbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      /* gap: 12px; */
      gap: 18px;
      margin-bottom: 22px;
      flex-wrap: wrap;
      padding: 12px 18px;
    }

    .topbar-group {
      display: flex;
      align-items: center;
      gap: 8px;
      gap: 16px;
    }

    a,
    button {
      font: inherit;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      min-height: 38px;
      padding: 0 14px;
      border-radius: 8px;
      border: 1px solid var(--border);
      background: rgba(255, 255, 255, 0.035);
      color: var(--text-2);
      text-decoration: none;
      font-weight: 700;
      font-size: 13px;
      cursor: pointer;
      transition:
        transform 0.14s,
        background 0.14s,
        border-color 0.14s,
        color 0.14s;
    }

    .btn-copy {
      border-color: var(--cyan-border);
      background: rgba(56, 189, 248, 0.08);
      color: var(--cyan);
      font-weight: 600;
    }

    .article {
      position: relative;
      border: 1px solid var(--border-hi);
      background: var(--surface-1);
      border-radius: var(--radius);
      box-shadow: var(--shadow-card);
      backdrop-filter: blur(24px) saturate(1.25);
      -webkit-backdrop-filter: blur(24px) saturate(1.25);
      overflow: hidden;
    }

    .article::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--cyan) 42%, #a78bfa 58%, transparent);
      opacity: 0.82;
    }

    .article-header {
      padding: 34px 36px;
      border-bottom: 1px solid var(--border);
    }

    .eyebrow {
      display: inline-flex;
      margin-bottom: 16px;
      padding: 6px 10px;
      border: 1px solid var(--cyan-border);
      border-radius: 999px;
      background: var(--cyan-faint);
      color: var(--cyan);
      font: 500 11px var(--font-mono);
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    h1 {
      font-family: var(--font-display);
      font-size: clamp(1.65rem, 4vw, 2.4rem);
      line-height: 1.15;
      letter-spacing: -0.04em;
      margin-bottom: 16px;
    }

    .meta {
      color: var(--text-3);
      font-size: 13px;
      /* font-family: var(--font-mono); */
      font-family: var(--font-body);
      letter-spacing: 0.02em;
    }

    .article-body {
      /* padding: 36px; */
      padding: 32px;
    }

    .content {
      color: var(--text);
      font-size: 15.5px;
      line-height: 1.75;
      letter-spacing: 0.01em;
      word-break: break-word;
    }

    .inline-link {
      color: #67d8ff;
      overflow-wrap: anywhere;
      text-decoration: underline;
      text-decoration-color: rgba(103, 216, 255, 0.35);
      text-underline-offset: 3px;
    }

    .toast-container {
      position: fixed;
      bottom: 32px;
      right: 32px;
      z-index: var(--z-toast);
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .toast {
      background: var(--surface-1);
      /* border: 1px solid var(--border-md); */
      border-radius: var(--radius-sm);
      padding: 12px 16px;
      min-width: 300px;
      max-width: 420px;
      display: flex;
      align-items: flex-start;
      gap: 12px;
      box-shadow:
        0 0 0 1px var(--border),
        0 8px 32px rgba(0, 0, 0, 0.5);
      transform: scale(0.94) translateY(12px);
      opacity: 0;
      filter: blur(6px);
      transition:
        transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1),
        opacity 0.35s ease,
        filter 0.35s ease;
      backdrop-filter: blur(20px) saturate(1.3);
      -webkit-backdrop-filter: blur(20px) saturate(1.3);
      pointer-events: auto;
      position: relative;
      overflow: hidden;
      align-items: center;
    }

    .toast.is-active {
      transform: scale(1) translateY(0);
      opacity: 1;
      filter: blur(0);
    }

    .toast-success {
      border-color: var(--success-border);
      box-shadow:
        0 0 0 1px var(--success-border),
        0 8px 32px rgba(0, 0, 0, 0.5);
    }

    .toast-success::before {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: var(--radius-sm);
      background: linear-gradient(135deg, var(--success-faint), transparent 60%);
      pointer-events: none;
    }

    .toast-error {
      border-color: var(--danger-border);
      box-shadow:
        0 0 0 1px var(--danger-border),
        0 8px 32px rgba(0, 0, 0, 0.5);
    }

    .toast-error::before {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: var(--radius-sm);
      background: linear-gradient(135deg, var(--danger-faint), transparent 60%);
      pointer-events: none;
    }

    .toast-info {
      border-color: var(--cyan-border);
      box-shadow:
        0 0 0 1px var(--cyan-border),
        0 8px 32px rgba(0, 0, 0, 0.5),
        0 0 24px var(--cyan-glow);
    }

    .toast-info::before {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: var(--radius-sm);
      background: linear-gradient(135deg, var(--cyan-faint), transparent 60%);
      pointer-events: none;
    }

    .toast-icon {
      flex-shrink: 0;
      width: 28px;
      height: 28px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      z-index: 1;
    }

    .toast-success .toast-icon {
      background: var(--success-faint);
      color: var(--success);
    }

    .toast-error .toast-icon {
      background: var(--danger-faint);
      color: var(--danger);
    }

    .toast-info .toast-icon {
      background: var(--cyan-faint);
      color: var(--cyan);
    }

    .toast-msg {
      flex: 1;
      font-size: 14px;
      font-weight: 500;
      color: var(--text);
      line-height: 1.5;
      padding: 2px 0;
      position: relative;
      z-index: 1;
    }

    .toast-dismiss {
      flex-shrink: 0;
      width: 20px;
      height: 20px;
      border: none;
      background: none;
      color: var(--text-3);
      cursor: pointer;
      padding: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 4px;
      opacity: 0;
      transition: opacity 0.2s ease;
      position: relative;
      z-index: 1;
    }

    .toast:hover .toast-dismiss {
      opacity: 1;
    }

    .toast-dismiss:hover {
      color: var(--text);
      background: var(--surface-hover);
    }

    .toast-bar {
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 3px;
      border-radius: 0 0 var(--radius-sm) var(--radius-sm);
      background: rgba(255, 255, 255, 0.06);
      pointer-events: none;
      transform-origin: left;
      transform: scaleX(0);
      will-change: transform;
    }

    .toast-success .toast-bar {
      background: var(--success-border);
    }

    .toast-error .toast-bar {
      background: var(--danger-border);
    }

    .toast-info .toast-bar {
      background: var(--cyan-border);
    }

    #backToTop {
      position: fixed;
      right: 28px;
      bottom: 28px;
      width: 52px;
      height: 52px;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 50%;
      background: rgba(15, 23, 42, 0.85);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      color: white;
      cursor: pointer;
      opacity: 0;
      visibility: hidden;
      transform: translateY(15px);
      transition: 0.25s ease;
      z-index: 55;
      font: inherit;
      appearance: none;
      -webkit-appearance: none;
    }

    #backToTop.show {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    #backToTop:active {
      transform: scale(0.95);
    }

    #backToTop svg {
      transition: transform 0.25s ease;
    }

    @media (min-width: 480px) {
      ::-webkit-scrollbar {
        width: 10px;
      }

      ::-webkit-scrollbar-track {
        background: rgba(8, 13, 26, 0.9);
      }

      ::-webkit-scrollbar-thumb {
        background: linear-gradient(180deg, rgba(56, 189, 248, 0.6), rgba(14, 165, 233, 0.4));
        border-radius: 100px;
        border: 2px solid rgba(8, 13, 26, 0.9);
      }

      @media (hover: hover) {
        ::-webkit-scrollbar-thumb:hover {
          background: linear-gradient(180deg, rgba(125, 211, 252, 0.8), rgba(56, 189, 248, 0.6));
        }
      }
    }

    html {
      scrollbar-width: thin;
      scrollbar-color: rgba(56, 189, 248, 0.5) rgba(8, 13, 26, 0.9);
    }

    @media (hover: hover) {
      .btn:hover {
        background: rgba(255, 255, 255, 0.08);
        color: var(--text);
        transform: translateY(-1px);
      }

      .btn-copy:hover {
        background: rgba(56, 189, 248, 0.16);
        color: #bae6fd;
        border-color: rgba(56, 189, 248, 0.45);
      }

      #backToTop:hover {
        background: #1e293b;
        transform: translateY(-4px);
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35);
      }

      #backToTop:hover svg {
        transform: translateY(-2px);
      }
    }

    @media (max-width: 560px) {
      .toast {
        min-width: auto;
        width: calc(100vw - 32px);
      }

      .toast-container {
        right: 16px;
        bottom: 16px;
        left: 16px;
      }

      .article-header {
        padding: 24px;
      }

      .article-body {
        padding: 24px 18px 24px 24px;
      }
    }

    @media (max-width: 825px) {
      .article {
        border-left:  none;
        border-right:  none;
      }
    }
  </style>
</head>

<body>
  <main class="shell">
    <nav class="topbar">
      <a class="btn" href="/explore#<%= entry._id %>">
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="15 18 9 12 15 6" />
        </svg>
        Back to Home
      </a>
      <div class="topbar-group">
        <button class="btn" type="button" id="copyLink">Copy Link</button>
        <button class="btn btn-copy" type="button" id="copyLinkIcon" title="Copy public link" style="display: flex; align-items: center; gap: 6px;">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
          </svg>
          Copy Text
        </button>
      </div>
    </nav>

    <article class="article">
      <header class="article-header">
        <span class="eyebrow"><% const ownerName = entry.ownerName || entry.email; %><%= ownerName ? `Note by ${ownerName}` : 'Public Note' %></span>
        <h1><%= entry.name %></h1>
        <p class="meta">
          Published <%= entry.createdAt ? new Date(entry.createdAt).toLocaleDateString('en', { year: 'numeric', month: 'short', day: 'numeric' }) : 'recently' %>
        </p>
      </header>
      <div class="article-body">
        <div class="content md-content" id="content"><%- typeof renderMarkdown === 'function' ? renderMarkdown(entry.info || '') : '' %></div>
      </div>
    </article>
  </main>

  <div class="toast-container" id="toastContainer" aria-live="polite" aria-atomic="true"></div>
  <button id="backToTop" aria-label="Back to top">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m18 15-6-6-6 6" />
    </svg>
  </button>

  <script src="https://cdn.jsdelivr.net/npm/dompurify@3.2.3/dist/purify.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/marked@15.0.6/marked.min.js"></script>
  <script src="/js/linkify-it.bundle.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/highlight.js@11.11.1/lib/common.min.js"></script>
  <script src="/js/markdown-renderer.js"></script>
  <script>
    const entry = <%- JSON.stringify(entry) %>;
    const content = document.getElementById('content');
    const toastContainer = document.getElementById('toastContainer');
    const backToTop = document.getElementById('backToTop');

    function appendLinkedContent(container, text = '') {
      const rawText = String(text || '');
      const urlPattern = /(^|[\s(])((?:https?:\/\/)?(?:www\.)?[a-z0-9][a-z0-9-]*(?:\.[a-z0-9][a-z0-9-]*)+(?:\/[^\s<>"']*)?)/gi;
      let lastIndex = 0;
      let match;

      while ((match = urlPattern.exec(rawText)) !== null) {
        const [fullMatch, prefix, candidate] = match;
        const urlStart = match.index + prefix.length;
        container.append(document.createTextNode(rawText.slice(lastIndex, urlStart)));

        const href = /^https?:\/\//i.test(candidate) ? candidate : `https://${candidate}`;
        const link = document.createElement('a');
        link.className = 'inline-link';
        link.href = href;
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
        link.textContent = candidate;
        container.append(link);

        lastIndex = match.index + fullMatch.length;
      }

      container.append(document.createTextNode(rawText.slice(lastIndex)));
    }

    function dismissToast(toast) {
      if (!toast || toast.dataset.dismissing === 'true') return;
      toast.dataset.dismissing = 'true';
      toast.classList.remove('is-active');
      setTimeout(() => toast.remove(), 400);
    }

    function showToast(message, type = 'success') {
      const visibleToasts = [...toastContainer.querySelectorAll('.toast')];
      while (visibleToasts.length >= 3) {
        dismissToast(visibleToasts.shift());
      }

      const toast = document.createElement('div');
      toast.className = `toast toast-${type}`;

      let iconSvg;
      if (type === 'success') {
        iconSvg =
          '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
      } else if (type === 'info') {
        iconSvg =
          '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>';
      } else {
        iconSvg =
          '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>';
      }

      toast.innerHTML =
        `<div class="toast-icon">${iconSvg}</div>` +
        `<span class="toast-msg">${message}</span>` +
        `<button class="toast-dismiss" aria-label="Dismiss"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>` +
        `<div class="toast-bar"></div>`;

      toastContainer.appendChild(toast);

      void toast.offsetHeight;
      toast.classList.add('is-active');

      const bar = toast.querySelector('.toast-bar');
      const dismissBtn = toast.querySelector('.toast-dismiss');
      dismissBtn.addEventListener('click', () => dismissToast(toast));

      let remaining = 3000;
      let start = Date.now();
      let timer;

      function startTimer() {
        bar.style.transition = 'none';
        bar.style.transform = 'scaleX(1)';
        void bar.offsetWidth;
        bar.style.transition = `transform ${remaining}ms cubic-bezier(0.22, 1, 0.36, 1)`;
        bar.style.transform = 'scaleX(0)';
        start = Date.now();
        timer = setTimeout(() => dismissToast(toast), remaining);
      }

      function pauseTimer() {
        clearTimeout(timer);
        const elapsed = Date.now() - start;
        remaining -= elapsed;
        if (remaining <= 0) { dismissToast(toast); return; }
        bar.style.transition = 'none';
        bar.style.transform = getComputedStyle(bar).transform;
        void bar.offsetWidth;
        bar.style.transition = `transform ${remaining}ms cubic-bezier(0.22, 1, 0.36, 1)`;
        bar.style.transform = 'scaleX(0)';
        start = Date.now();
        timer = setTimeout(() => dismissToast(toast), remaining);
      }

      toast.addEventListener('mouseenter', pauseTimer);
      toast.addEventListener('mouseleave', startTimer);
      startTimer();
    }

    async function copyCurrentLink() {
      try {
        if (navigator.clipboard && window.isSecureContext) {
          await navigator.clipboard.writeText(window.location.href);
        } else {
          const textarea = document.createElement('textarea');
          textarea.value = window.location.href;
          textarea.setAttribute('readonly', '');
          textarea.style.position = 'fixed';
          textarea.style.opacity = '0';
          document.body.appendChild(textarea);
          textarea.select();
          document.execCommand('copy');
          textarea.remove();
        }
        showToast('Public link copied');
      } catch (err) {
        console.error(err);
        showToast('Failed to copy link', 'error');
      }
    }

    async function copyContent() {
      const text = entry.info || '';
      try {
        if (navigator.clipboard && window.isSecureContext) {
          await navigator.clipboard.writeText(text);
        } else {
          const textarea = document.createElement('textarea');
          textarea.value = text;
          textarea.setAttribute('readonly', '');
          textarea.style.position = 'fixed';
          textarea.style.opacity = '0';
          document.body.appendChild(textarea);
          textarea.select();
          document.execCommand('copy');
          textarea.remove();
        }
        showToast('Content copied');
      } catch (err) {
        console.error(err);
        showToast('Failed to copy content', 'error');
      }
    }

    enhanceMarkdownContent(content);
    document.getElementById('copyLink').addEventListener('click', copyCurrentLink);
    document.getElementById('copyLinkIcon').addEventListener('click', copyContent);

    if (backToTop) {
      window.addEventListener('scroll', () => {
        backToTop.classList.toggle('show', window.scrollY > window.innerHeight * 0.5);
      });

      backToTop.addEventListener('click', () => {
        window.scrollTo({
          top: 0,
          behavior: 'smooth',
        });
      });
    }
  </script>
</body>

</html>
