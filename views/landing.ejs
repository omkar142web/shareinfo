<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ShareInfo - Your Knowledge Wall</title>
  <meta name="description" content="ShareInfo lets you save, organize, and share notes, links, and data publicly or privately." />
  <meta property="og:title" content="ShareInfo" />
  <meta property="og:description" content="Your personal knowledge wall for notes, links, snippets, and ideas." />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary_large_image" />
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;600;700;800&family=DM+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/highlight.js@11.11.1/styles/github-dark.min.css" />
  <link rel="stylesheet" href="/css/markdown-content.css" />
  <style>
    :root {
      --bg: #0d1628;
      --surface-1: rgba(22, 34, 58, 0.82);
      --surface-2: rgba(30, 46, 74, 0.62);
      --text: #f0f6ff;
      --text-2: #a8bdd4;
      --text-3: #607a96;
      --cyan: #38bdf8;
      --cyan-faint: rgba(56, 189, 248, 0.1);
      --cyan-border: rgba(56, 189, 248, 0.28);
      --cyan-glow: rgba(56, 189, 248, 0.22);
      --success: #34d399;
      --success-faint: rgba(52, 211, 153, 0.1);
      --success-border: rgba(52, 211, 153, 0.28);
      --border: rgba(255, 255, 255, 0.09);
      --border-md: rgba(255, 255, 255, 0.13);
      --border-hi: rgba(255, 255, 255, 0.2);
      --shadow-card: 0 0 0 1px var(--border), 0 8px 40px rgba(0, 0, 0, 0.55), 0 2px 8px rgba(0, 0, 0, 0.3);
      --shadow-hover: 0 0 0 1px var(--cyan-border), 0 16px 60px rgba(0, 0, 0, 0.65), 0 0 40px var(--cyan-glow);
      --font-display: "Sora", system-ui, sans-serif;
      --font-body: "DM Sans", system-ui, sans-serif;
      --font-mono: "JetBrains Mono", monospace;
      --radius: 16px;
      --radius-sm: 10px;
      --gap: 18px;
      --z-modal: 50;
      --z-toast: 60;
      --shadow-modal: 0 0 0 1px var(--border-hi), 0 32px 80px rgba(0, 0, 0, 0.7), 0 8px 24px rgba(0, 0, 0, 0.5);
      --danger: #f87171;
      --danger-faint: rgba(248, 113, 113, 0.1);
      --danger-border: rgba(248, 113, 113, 0.28);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      min-height: 100vh;
      font-family: var(--font-body);
      background:
        radial-gradient(circle at 15% 12%, rgba(56, 189, 248, 0.16), transparent 28rem),
        radial-gradient(circle at 85% 18%, rgba(52, 211, 153, 0.1), transparent 24rem),
        linear-gradient(180deg, #0d1628 0%, #09111f 100%);
      color: var(--text);
      overflow-x: hidden;
    }

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      background-image:
        linear-gradient(rgba(255, 255, 255, 0.024) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.024) 1px, transparent 1px);
      background-size: 42px 42px;
      pointer-events: none;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .site-header {
      position: sticky;
      top: 0;
      /* z-index: 100; */
      z-index: 45;
      height: 68px;
      background: rgba(8, 13, 26, 0.82);
      border-bottom: 1px solid var(--border-md);
      backdrop-filter: blur(24px) saturate(1.4);
      -webkit-backdrop-filter: blur(24px) saturate(1.4);
    }

    .section {
      width: min(1120px, calc(100% - 32px));
      margin: 0 auto;
    }

    .header-inner {
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 28px;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }

    .header-brand {
      display: flex;
      align-items: center;
      gap: 10px;
      user-select: none;
      text-decoration: none;
    }

    .brand-pulse {
      display: inline-block;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--cyan);
      box-shadow:
        0 0 10px var(--cyan),
        0 0 20px var(--cyan-glow);
      animation: pulse 2.4s ease-in-out infinite;
      flex-shrink: 0;
    }

    @keyframes pulse {

      0%,
      100% {
        opacity: 1;
        transform: scale(1);
      }

      50% {
        opacity: 0.5;
        transform: scale(0.7);
      }
    }

    .brand-title {
      font-family: var(--font-display);
      font-size: 1.2rem;
      font-weight: 800;
      color: var(--text);
      cursor: pointer;
    }

    .brand-title em {
      font-style: normal;
      color: var(--cyan);
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 38px;
      padding: 0 15px;
      border-radius: 8px;
      border: 1px solid var(--border);
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
      transition: transform 0.16s, background 0.16s, border-color 0.16s;
    }

    .btn-primary {
      background: var(--cyan);
      color: #06111f;
      border: none;
      border-radius: var(--radius-sm);
      gap: 7px;
      white-space: nowrap;
    }

    .btn-ghost {
      background: rgba(255, 255, 255, 0.035);
      color: var(--text-2);
    }

    #backToTop {
      position: fixed;
      right: 28px;
      bottom: 28px;
      width: 52px;
      height: 52px;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 50%;
      background: rgba(15, 23, 42, 0.85);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      color: white;
      cursor: pointer;
      opacity: 0;
      visibility: hidden;
      transform: translateY(15px);
      transition: 0.25s ease;
      z-index: 45;
      font: inherit;
      appearance: none;
      -webkit-appearance: none;
    }

    #backToTop.show {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    #backToTop:active {
      transform: scale(0.95);
    }

    #backToTop svg {
      transition: transform 0.25s ease;
    }

    @media (hover: hover) {
      .btn:hover {
        transform: translateY(-1px);
      }

      #backToTop:hover {
        background: #1e293b;
        transform: translateY(-4px);
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35);
      }

      #backToTop:hover svg {
        transform: translateY(-2px);
      }
    }

    .hero {
      min-height: calc(100vh - 68px);
      display: grid;
      align-items: center;
      /* padding: 72px 0 48px; */
      padding: 42px 0 38px;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.95fr);
      gap: 42px;
      align-items: center;
    }

    .eyebrow {
      display: inline-flex;
      width: fit-content;
      margin-bottom: 18px;
      padding: 6px 10px;
      border: 1px solid var(--cyan-border);
      border-radius: 999px;
      background: var(--cyan-faint);
      color: var(--cyan);
      font: 500 11px var(--font-mono);
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    h1 {
      max-width: 760px;
      font-family: var(--font-display);
      font-size: clamp(3rem, 7vw, 6.2rem);
      line-height: 0.95;
      letter-spacing: -0.06em;
    }

    .hero-copy {
      max-width: 610px;
      margin: 22px 0 28px;
      color: var(--text-2);
      font-size: 1.08rem;
      line-height: 1.75;
    }

    .hero-actions {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    .hero-panel {
      border: 1px solid var(--border-hi);
      border-radius: 18px;
      background: var(--surface);
      box-shadow: 0 30px 90px rgba(0, 0, 0, 0.45);
      overflow: hidden;
    }

    .panel-top {
      display: flex;
      justify-content: space-between;
      padding: 16px;
      border-bottom: 1px solid var(--border);
      color: var(--text-3);
      font: 500 11px var(--font-mono);
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .preview-list {
      display: grid;
      gap: 12px;
      padding: 16px;
    }

    .preview-item,
    .info-card,
    .use-card {
      border: 1px solid var(--border);
      background: rgba(13, 22, 40, 0.58);
      border-radius: 8px;
    }

    .preview-item {
      padding: 14px;
    }

    .preview-item strong {
      display: block;
      font-size: 14px;
      margin-bottom: 8px;
    }

    .preview-item span {
      color: var(--text-3);
      font-size: 12px;
      line-height: 1.55;
    }

    .use-cases-head {
      padding: 42px 0 14px;
      display: grid;
      gap: 8px;
    }

    .use-cases-head h2 {
      font-family: var(--font-display);
      font-size: clamp(1.6rem, 3.5vw, 2.8rem);
      letter-spacing: -0.04em;
    }

    .use-cases-head p {
      color: var(--text-2);
      font-size: 14.5px;
      line-height: 1.65;
      max-width: 560px;
    }

    .use-cases {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 14px;
      padding: 18px 0 66px;
    }

    .use-card {
      padding: 24px 20px 22px;
      border: 1px solid var(--border);
      background: rgba(13, 22, 40, 0.58);
      border-radius: 12px;
      transition: transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1),
        border-color 0.22s,
        box-shadow 0.22s;
    }

    @media (hover: hover) {
      .use-card:hover {
        transform: translateY(-3px);
        border-color: var(--cyan-border);
        box-shadow: 0 8px 32px rgba(56, 189, 248, 0.1);
      }
    }

    .use-icon {
      width: 38px;
      height: 38px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 14px;
      background: var(--cyan-faint);
      border: 1px solid var(--cyan-border);
      color: var(--cyan);
    }

    .use-card h3 {
      font-family: var(--font-display);
      font-size: 16px;
      font-weight: 700;
      letter-spacing: -0.02em;
      margin-bottom: 8px;
    }

    .use-card p {
      color: var(--text-3);
      font-size: 13.5px;
      line-height: 1.65;
    }

    .public-head {
      display: grid;
      gap: 16px;
      margin-bottom: 20px;
    }

    .public-head h2 {
      font-family: var(--font-display);
      font-size: clamp(1.8rem, 4vw, 3.2rem);
      letter-spacing: -0.04em;
    }

    .search-row {
      display: flex;
      gap: 10px;
      align-items: stretch;
    }

    .search-row input {
      flex: 1;
      min-height: 44px;
      padding: 0 14px;
      border-radius: 8px;
      border: 1px solid var(--border-hi);
      background: rgba(13, 22, 40, 0.72);
      color: var(--text);
      font: 500 14px var(--font-body);
      outline: none;
    }

    .search-input-wrap {
      position: relative;
      flex: 1;
      min-width: 0;
    }

    .search-input-wrap input {
      width: 100%;
      padding-right: 36px;
    }

    .search-clear {
      position: absolute;
      right: 8px;
      top: 50%;
      transform: translateY(-50%);
      background: none;
      border: none;
      color: #888;
      cursor: pointer;
      padding: 4px;
      display: flex;
      border-radius: 50%;
      transition: color 0.15s, background 0.15s;
    }

    .search-clear[hidden] {
      display: none;
    }

    .search-clear:hover {
      color: var(--text);
      background: rgba(255, 255, 255, 0.1);
    }

    .sort-wrap {
      position: relative;
      flex: 0 0 auto;
    }

    .sort-btn {
      width: 44px;
      height: 44px;
      border: 1px solid var(--border-hi);
      border-radius: 8px;
      background: rgba(13, 22, 40, 0.72);
      color: var(--text-2);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition:
        background 0.14s,
        border-color 0.14s,
        color 0.14s,
        transform 0.12s;
    }

    .sort-btn[aria-expanded="true"] {
      color: var(--cyan);
      border-color: var(--cyan-border);
      background: rgba(56, 189, 248, 0.09);
    }

    .sort-menu {
      position: absolute;
      top: calc(100% + 8px);
      right: 0;
      z-index: 35;
      width: 180px;
      padding: 6px;
      border: 1px solid var(--border-hi);
      border-radius: 10px;
      background: rgba(12, 20, 36, 0.96);
      box-shadow: 0 18px 42px rgba(0, 0, 0, 0.45);
      backdrop-filter: blur(18px) saturate(1.25);
      -webkit-backdrop-filter: blur(18px) saturate(1.25);
    }

    .sort-menu[hidden] {
      display: none;
    }

    .sort-option {
      width: 100%;
      min-height: 36px;
      padding: 0 10px;
      border: 0;
      border-radius: 7px;
      background: transparent;
      color: var(--text-2);
      cursor: pointer;
      font: 700 12px var(--font-body);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      text-align: left;
    }

    .sort-option:not(:first-child) {
      margin-top: 6px;
    }

    .sort-option svg {
      opacity: 0;
      color: var(--cyan);
      flex-shrink: 0;
    }

    .sort-option.is-active {
      color: var(--text);
      background: rgba(56, 189, 248, 0.1);
    }

    .sort-option.is-active svg {
      opacity: 1;
    }

    @media (hover: hover) {

      .sort-btn:hover,
      .sort-option:hover {
        color: var(--text);
        background: rgba(255, 255, 255, 0.08);
      }

      .sort-btn:hover {
        transform: translateY(-1px);
      }
    }

    .masonry-wall {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: var(--gap);
      align-items: start;
      padding-bottom: 34px;
    }

    .info-card {
      width: 100%;
      background: var(--surface-1);
      border: 1px solid var(--border-md);
      border-radius: var(--radius);
      padding: 0;
      overflow: hidden;
      position: relative;
      box-shadow: var(--shadow-card);
      backdrop-filter: blur(20px) saturate(1.3);
      -webkit-backdrop-filter: blur(20px) saturate(1.3);
      opacity: 0;
      transform: translateY(18px);
      animation: card-in 0.5s ease forwards;
      transition:
        transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1),
        box-shadow 0.22s ease,
        border-color 0.22s ease;
    }

    .info-card::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--cyan), transparent);
      opacity: 0.4;
      transition: opacity 0.25s;
    }

    @keyframes card-in {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @media (hover: hover) {
      .info-card:hover::before {
        opacity: 0.9;
      }

      .info-card:hover {
        box-shadow: var(--shadow-hover);
        transform: translateY(-3px);
        border-color: var(--border-hi);
      }
    }

    .card-strip {
      padding: 10px 14px 8px;
      border-bottom: 1px solid var(--border);
      color: var(--success);
      font: 500 10px var(--font-mono);
      text-transform: uppercase;
      letter-spacing: 0.1em;
    }

    .card-body {
      padding: 14px;
    }

    .card-title {
      font-family: var(--font-display);
      font-size: 17px;
      letter-spacing: -0.02em;
      margin-bottom: 10px;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      text-transform: capitalize;

    }

    .card-text {
      color: var(--text-2);
      font-size: 13.5px;
      line-height: 1.65;
      word-break: break-word;
    }

    .card-text-snippet {
      display: -webkit-box;
      -webkit-line-clamp: 5;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    /* ── Skeleton loading state ──────────────────────── */
    .info-card.card-pending .view-more-btn {
      opacity: 0;
    }

    .info-card.card-pending .card-text {
      position: relative;
      min-height: 140px;   /* was 92px — room for 6 bars */
      color: transparent;
      overflow: hidden;
    }

    .info-card.card-pending .card-text > * {
      visibility: hidden;
    }

    /* Skeleton bars — brighter than card background for contrast */
    .info-card.card-pending .card-text::before {
      content: "";
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(#2a3f63, #2a3f63),
        linear-gradient(#2a3f63, #2a3f63),
        linear-gradient(#2a3f63, #2a3f63),
        linear-gradient(#2a3f63, #2a3f63),
        linear-gradient(#2a3f63, #2a3f63),
        linear-gradient(#2a3f63, #2a3f63);
      background-repeat: no-repeat;
      background-size: 80% 12px, 100% 12px, 60% 12px, 90% 12px, 75% 12px, 45% 12px;
      background-position: 0 0, 0 24px, 0 48px, 0 72px, 0 96px, 0 120px;
      border-radius: 4px;
      animation: skeleton-pulse 1.8s ease-in-out infinite;
    }

    /* ONE shimmer for all bars — GitHub / Stripe / Vercel pattern */
    .info-card.card-pending .card-text::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(
        110deg,
        transparent 35%,
        rgba(255, 255, 255, 0.05) 43%,
        rgba(255, 255, 255, 0.28) 50%,
        rgba(255, 255, 255, 0.05) 57%,
        transparent 65%
      );
      background-repeat: no-repeat;
      background-size: 600px 100%;
      background-attachment: fixed;
      animation: skeleton-shimmer 1.8s linear infinite;

      -webkit-mask-image:
        linear-gradient(#000, #000), linear-gradient(#000, #000),
        linear-gradient(#000, #000), linear-gradient(#000, #000),
        linear-gradient(#000, #000), linear-gradient(#000, #000);
      mask-image:
        linear-gradient(#000, #000), linear-gradient(#000, #000),
        linear-gradient(#000, #000), linear-gradient(#000, #000),
        linear-gradient(#000, #000), linear-gradient(#000, #000);
      -webkit-mask-repeat: no-repeat;
      mask-repeat: no-repeat;
      -webkit-mask-size: 80% 12px, 100% 12px, 60% 12px, 90% 12px, 75% 12px, 45% 12px;
      mask-size: 80% 12px, 100% 12px, 60% 12px, 90% 12px, 75% 12px, 45% 12px;
      -webkit-mask-position: 0 0, 0 24px, 0 48px, 0 72px, 0 96px, 0 120px;
      mask-position: 0 0, 0 24px, 0 48px, 0 72px, 0 96px, 0 120px;
    }

    @keyframes skeleton-shimmer {
      0% {
        background-position: -600px 0;
      }
      100% {
        background-position: 100vw 0;
      }
    }

    @keyframes skeleton-pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.55; }
    }

    @media (prefers-reduced-motion: reduce) {
      .info-card.card-pending .card-text::after {
        animation: none;
      }
      .info-card.card-pending .card-text::before {
        animation: skeleton-pulse 2.4s ease-in-out infinite;
      }
    }

    .card-copy-icon {
      position: absolute;
      top: 2px;
      right: 3px;
      width: 32px;
      height: 32px;
      font-family: var(--font-body);
      font-weight: 600;
      color: var(--cyan);
      background: transparent;
      border: none;
      border-radius: 8px;
      padding: 0;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      transform: translateY(-2px) scale(0.92);
      z-index: 3;
      backdrop-filter: blur(8px);
      transition:
        opacity 0.18s,
        transform 0.18s,
        background 0.15s,
        color 0.15s,
        border-color 0.15s,
        box-shadow 0.15s;
    }

    @media (hover: hover) {

      .info-card:hover .card-copy-icon,
      .card-copy-icon:hover,
      .card-copy-icon:focus-visible {
        opacity: 1;
        transform: translateY(0) scale(1);
      }

      .card-copy-icon:hover {
        color: #bae6fd;
        text-shadow: 0 4px 16px rgba(56, 189, 248, 0.22);
      }
    }

    @media (hover: none) {
      .card-copy-icon {
        opacity: 0.75;
        transform: translateY(0) scale(1);
      }
    }

    .card-copy-icon:focus-visible {
      outline: 2px solid var(--cyan-border);
      outline-offset: 2px;
    }

    .card-copy-icon.is-copied {
      color: var(--success);
      opacity: 1;
      transform: translateY(0) scale(1.08);
    }

    .card-footer {
      display: flex;
      gap: 8px;
      padding: 0 14px 14px;
      flex-wrap: wrap;
    }

    .card-action {
      border: 1px solid var(--border);
      border-radius: 8px;
      background: rgba(255, 255, 255, 0.035);
      color: var(--text-2);
      padding: 7px 10px;
      font: 600 12px var(--font-body);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 5px;
      transition:
        background 0.14s,
        color 0.14s,
        border-color 0.14s,
        transform 0.12s;
    }

    @media (hover: hover) {
      .card-action:hover {
        background: rgba(255, 255, 255, 0.08);
        color: var(--text);
        transform: translateY(-1px);
      }
    }

    .card-action-copy {
      border-color: var(--cyan-border);
      background: rgba(56, 189, 248, 0.08);
      color: var(--cyan);
    }

    @media (hover: hover) {
      .card-action-copy:hover {
        background: rgba(56, 189, 248, 0.16);
        color: #bae6fd;
        border-color: rgba(56, 189, 248, 0.45);
      }
    }

    .inline-link {
      color: #67d8ff;
      overflow-wrap: anywhere;
      text-decoration: underline;
      text-decoration-color: rgba(103, 216, 255, 0.35);
      text-underline-offset: 3px;
    }

    .empty-state {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 70px 24px;
      text-align: center;
      gap: 18px;
      opacity: 0;
      transform: translateY(12px);
      animation: emptyStateFadeIn 0.4s ease-out forwards;
      width: 100%;
      max-width: 520px;
      margin: 0 auto;
    }

    .empty-state.empty-animate {
      animation: emptyStateFadeIn 0.4s ease-out forwards;
    }

    @keyframes emptyStateFadeIn {
      from {
        opacity: 0;
        transform: translateY(12px) scale(0.98);
      }
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    .empty-glyph {
      width: 96px;
      height: 96px;
      border-radius: 28px;
      background: var(--surface-1);
      border: 1px solid var(--border-md);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--text-3);
      backdrop-filter: blur(12px);
    }

    .empty-state-illustration {
      position: relative;
      width: 180px;
      height: 180px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 6px;
    }

    .empty-glow-bg {
      position: absolute;
      inset: -20px;
      background: radial-gradient(circle, rgba(56, 189, 248, 0.18) 0%, rgba(6, 182, 212, 0.04) 55%, transparent 75%);
      border-radius: 50%;
      pointer-events: none;
      filter: blur(12px);
    }

    .empty-orbit-ring {
      position: absolute;
      inset: 12px;
      border: 1.5px dashed rgba(56, 189, 248, 0.25);
      border-radius: 50%;
      animation: orbitRotate 28s linear infinite;
      pointer-events: none;
    }

    @keyframes orbitRotate {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }

    .empty-orbit-ring .particle {
      position: absolute;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #38bdf8;
      box-shadow: 0 0 10px #38bdf8, 0 0 20px rgba(56, 189, 248, 0.8);
    }

    .empty-orbit-ring .p1 { top: -3px; left: 50%; transform: translateX(-50%); }
    .empty-orbit-ring .p2 { bottom: 22%; right: -2px; }
    .empty-orbit-ring .p3 { bottom: 15%; left: 2%; }

    .floating-plus {
      position: absolute;
      font-family: var(--font-mono);
      font-size: 13px;
      font-weight: 700;
      color: rgba(56, 189, 248, 0.65);
      text-shadow: 0 0 8px rgba(56, 189, 248, 0.45);
      user-select: none;
      animation: floatPlus 4s ease-in-out infinite alternate;
    }

    .floating-plus.plus-1 { top: 12px; left: 16px; animation-delay: 0s; }
    .floating-plus.plus-2 { bottom: 24px; right: 18px; animation-delay: 1.3s; }
    .floating-plus.plus-3 { top: 50%; right: -8px; animation-delay: 2.5s; }

    @keyframes floatPlus {
      0% { transform: translateY(0) scale(0.9); opacity: 0.4; }
      100% { transform: translateY(-7px) scale(1.15); opacity: 0.95; }
    }

    .empty-graphic-wrapper {
      position: relative;
      width: 110px;
      height: 110px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .empty-doc-card {
      position: absolute;
      width: 80px;
      height: 96px;
      background: var(--surface-1);
      border: 1px solid var(--border-hi);
      border-radius: 12px;
      backdrop-filter: blur(14px);
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5), 0 0 20px rgba(56, 189, 248, 0.1);
      padding: 11px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      transform: rotate(-6deg) translateY(2px);
      transition: transform 0.3s ease;
    }

    .doc-header {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .doc-badge {
      width: 14px;
      height: 14px;
      border-radius: 4px;
      background: rgba(56, 189, 248, 0.25);
      border: 1px solid rgba(56, 189, 248, 0.4);
    }

    .doc-lines {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 3px;
    }

    .doc-line {
      height: 4px;
      border-radius: 2px;
      background: rgba(255, 255, 255, 0.15);
    }

    .doc-line.line-1 { width: 80%; background: rgba(56, 189, 248, 0.45); }
    .doc-line.line-2 { width: 50%; }
    .doc-line.line-3 { width: 100%; }
    .doc-line.line-4 { width: 90%; }
    .doc-line.line-5 { width: 65%; }

    .doc-body {
      display: flex;
      flex-direction: column;
      gap: 5px;
      margin-top: 4px;
    }

    .empty-magnifier {
      position: absolute;
      right: -8px;
      bottom: -6px;
      z-index: 2;
      filter: drop-shadow(0 10px 22px rgba(0, 0, 0, 0.65));
      animation: floatMagnifier 3.5s ease-in-out infinite alternate;
    }

    @keyframes floatMagnifier {
      0% { transform: translateY(0) rotate(0deg); }
      100% { transform: translateY(-7px) rotate(-4deg); }
    }

    .empty-title {
      font-family: var(--font-display);
      font-size: 1.75rem;
      font-weight: 800;
      color: #ffffff;
      letter-spacing: -0.02em;
      margin-bottom: 2px;
    }

    .empty-desc {
      max-width: 420px;
      font-size: 15px;
      color: var(--text-2);
      line-height: 1.6;
    }

    .empty-desc .query,
    .empty-search-highlight {
      display: inline-block;
      margin-top: 4px;
      color: #38bdf8;
      font-weight: 700;
      text-shadow: 0 0 10px rgba(56, 189, 248, 0.35);
      word-break: break-all;
    }

    .btn-retry {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 20px;
      border-radius: 12px;
      border: 1px solid rgba(56, 189, 248, 0.4);
      background: rgba(6, 15, 28, 0.4);
      color: #38bdf8;
      font-weight: 600;
      font-size: 14.5px;
      cursor: pointer;
      font-family: inherit;
      transition: all 0.15s ease;
      box-shadow: 0 0 16px rgba(56, 189, 248, 0.08);
    }

    .btn-retry:hover {
      background: rgba(56, 189, 248, 0.12);
      border-color: rgba(56, 189, 248, 0.65);
      color: #67e0ff;
      box-shadow: 0 0 24px rgba(56, 189, 248, 0.22);
    }

    .empty-action-wrap {
      margin-top: 8px;
    }

    .empty-public,
    .end-of-feed {
      color: var(--text-3);
      text-align: center;
      padding: 34px 0;
    }

    .modal-overlay {
      position: fixed;
      inset: 0;
      z-index: var(--z-modal);
      background: rgba(4, 8, 20, 0.75);
      backdrop-filter: blur(9px) saturate(1.2);
      -webkit-backdrop-filter: blur(9px) saturate(1.2);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
      opacity: 0;
      transition: opacity 0.25s ease;
    }

    .modal-overlay.is-open {
      opacity: 1;
    }

    .modal-overlay[hidden],
    .feed-loading[hidden],
    .end-of-feed[hidden],
    .empty-state[hidden] {
      display: none;
    }

    .modal-glass {
      width: 100%;
      /* max-width: 620px; */
      max-width: 710px;
      max-height: 88dvh;
      background: rgba(14, 22, 40, 0.9);
      border: 1px solid var(--border-hi);
      border-radius: 22px;
      box-shadow: var(--shadow-modal);
      display: flex;
      flex-direction: column;
      overflow: hidden;
      position: relative;
      transform: translateY(24px) scale(0.97);
      transition: transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .modal-glass::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 1px;
      background: linear-gradient(90deg,
          transparent,
          #a78bfa 40%,
          var(--cyan) 60%,
          transparent);
      opacity: 0.7;
    }

    .modal-overlay.is-open .modal-glass {
      transform: translateY(0) scale(1);
    }

    .modal-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      padding: 22px 24px 18px;
    }

    .modal-title {
      font-family: var(--font-display);
      font-size: 1.15rem;
      font-weight: 700;
      color: var(--text);
      letter-spacing: -0.04em;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .modal-close {
      flex-shrink: 0;
      width: 34px;
      height: 34px;
      border-radius: 8px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--border-md);
      color: var(--text-2);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition:
        background 0.24s,
        color 0.24s,
        transform 0.22s;
    }

    @media (hover: hover) {
      .modal-close:hover {
        background: var(--danger-faint);
        color: var(--danger);
        border-color: var(--danger-border);
        transform: rotate(90deg) scale(1.05);
      }
    }

    .modal-divider {
      height: 1px;
      background: var(--border);
      flex-shrink: 0;
    }

    .modal-body {
      flex: 1;
      overflow-y: auto;
      padding: 24px;
      overscroll-behavior: contain;
    }

    .modal-body .md-content {
      font-size: 14.5px;
      line-height: 1.75;
      color: var(--text-2);
      word-break: break-word;
    }

    .modal-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 24px;
      border-top: 1px solid var(--border);
      flex-shrink: 0;
    }

    .modal-char-count {
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--text-3);
      letter-spacing: 0.04em;
    }

    .modal-actions {
      flex-shrink: 0;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .modal-copy {
      height: 34px;
      border-radius: 8px;
      padding: 0 11px;
      background: rgba(56, 189, 248, 0.08);
      border: 1px solid var(--cyan-border);
      color: var(--cyan);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      font-family: var(--font-body);
      font-size: 12px;
      font-weight: 600;
      transition:
        background 0.14s,
        color 0.14s,
        border-color 0.14s,
        transform 0.12s;
    }

    @media (hover: hover) {
      .modal-copy:hover {
        background: rgba(56, 189, 248, 0.16);
        color: #bae6fd;
        border-color: rgba(56, 189, 248, 0.45);
        transform: translateY(-1px);
      }
    }

    .modal-copy.is-copied {
      background: var(--success-faint);
      color: var(--success);
      border-color: var(--success-border);
    }

    .btn-ghost {
      height: 34px;
      border-radius: 8px;
      padding: 0 14px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--border-md);
      color: var(--text-2);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      font-family: var(--font-body);
      font-size: 12px;
      font-weight: 600;
      transition:
        background 0.14s,
        color 0.14s,
        transform 0.12s;
    }

    nav a[href*="dashboard"i].btn-ghost {
      min-height: 35px;
      font-weight: 700;
    }

    nav a[href*="add"i].btn-primary {
      min-height: 35px;
      font-weight: 700;
    }

    @media (hover: hover) {
      .btn-ghost:hover {
        background: rgba(255, 255, 255, 0.08);
        color: var(--text);
        transform: translateY(-1px);
      }
    }

    .toast-container {
      position: fixed;
      bottom: 32px;
      right: 32px;
      z-index: var(--z-toast);
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .toast {
      background: var(--surface-1);
      /* border: 1px solid var(--border-md); */
      border-radius: var(--radius-sm);
      padding: 12px 16px;
      min-width: 300px;
      max-width: 420px;
      display: flex;
      align-items: flex-start;
      gap: 12px;
      box-shadow:
        0 0 0 1px var(--border),
        0 8px 32px rgba(0, 0, 0, 0.5);
      transform: scale(0.94) translateY(12px);
      opacity: 0;
      filter: blur(6px);
      transition:
        transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1),
        opacity 0.35s ease,
        filter 0.35s ease;
      backdrop-filter: blur(20px) saturate(1.3);
      -webkit-backdrop-filter: blur(20px) saturate(1.3);
      pointer-events: auto;
      position: relative;
      overflow: hidden;
      align-items: center;
    }

    .toast.is-active {
      transform: scale(1) translateY(0);
      opacity: 1;
      filter: blur(0);
    }

    .toast-success {
      border-color: var(--success-border);
      box-shadow:
        0 0 0 1px var(--success-border),
        0 8px 32px rgba(0, 0, 0, 0.5);
    }

    .toast-success::before {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: var(--radius-sm);
      background: linear-gradient(135deg, var(--success-faint), transparent 60%);
      pointer-events: none;
    }

    .toast-error {
      border-color: var(--danger-border);
      box-shadow:
        0 0 0 1px var(--danger-border),
        0 8px 32px rgba(0, 0, 0, 0.5);
    }

    .toast-error::before {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: var(--radius-sm);
      background: linear-gradient(135deg, var(--danger-faint), transparent 60%);
      pointer-events: none;
    }

    .toast-info {
      border-color: var(--cyan-border);
      box-shadow:
        0 0 0 1px var(--cyan-border),
        0 8px 32px rgba(0, 0, 0, 0.5),
        0 0 24px var(--cyan-glow);
    }

    .toast-info::before {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: var(--radius-sm);
      background: linear-gradient(135deg, var(--cyan-faint), transparent 60%);
      pointer-events: none;
    }

    .toast-icon {
      flex-shrink: 0;
      width: 28px;
      height: 28px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      z-index: 1;
    }

    .toast-success .toast-icon {
      background: var(--success-faint);
      color: var(--success);
    }

    .toast-error .toast-icon {
      background: var(--danger-faint);
      color: var(--danger);
    }

    .toast-info .toast-icon {
      background: var(--cyan-faint);
      color: var(--cyan);
    }

    .toast-msg {
      flex: 1;
      font-size: 14px;
      font-weight: 500;
      color: var(--text);
      line-height: 1.5;
      padding: 2px 0;
      position: relative;
      z-index: 1;
    }

    .toast-dismiss {
      flex-shrink: 0;
      width: 20px;
      height: 20px;
      border: none;
      background: none;
      color: var(--text-3);
      cursor: pointer;
      padding: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 4px;
      opacity: 0;
      transition: opacity 0.2s ease;
      position: relative;
      z-index: 1;
    }

    .toast:hover .toast-dismiss {
      opacity: 1;
    }

    .toast-dismiss:hover {
      color: var(--text);
      background: var(--surface-hover);
    }

    .toast-bar {
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 3px;
      border-radius: 0 0 var(--radius-sm) var(--radius-sm);
      background: rgba(255, 255, 255, 0.06);
      pointer-events: none;
      transform-origin: left;
      transform: scaleX(0);
      will-change: transform;
    }

    .toast-success .toast-bar {
      background: var(--success-border);
    }

    .toast-error .toast-bar {
      background: var(--danger-border);
    }

    .toast-info .toast-bar {
      background: var(--cyan-border);
    }



    .site-footer {
      border-top: 1px solid var(--border);
      margin-top: 46px;
      padding: 28px 0;
      color: var(--text-3);
      font-size: 13px;
    }

    @media (min-width: 480px) {
      ::-webkit-scrollbar {
        width: 7px;
      }

      ::-webkit-scrollbar-track {
        /* background: rgba(8, 13, 26, 0.9); */
        background: rgb(13 22 40);
      }

      ::-webkit-scrollbar-thumb {
        background: linear-gradient(180deg, rgba(56, 189, 248, 0.6), rgba(14, 165, 233, 0.4));
        border-radius: 100px;
        /* border: 2px solid rgba(8, 13, 26, 0.9); */
        border: 2px solid transparent;
      }

      @media (hover: hover) {
        ::-webkit-scrollbar-thumb:hover {
          background: linear-gradient(180deg, rgba(125, 211, 252, 0.8), rgba(56, 189, 248, 0.6));
        }
      }

      .modal-body::-webkit-scrollbar {
        width: 6px;
        height: 6px;
      }

      ::-webkit-scrollbar-corner {
       background: transparent;
      }

      .modal-body::-webkit-scrollbar-track {
        background: transparent;
      }

      .modal-body::-webkit-scrollbar-thumb {
        background: rgba(56, 189, 248, 0.25);
        border-radius: 100px;
      }

      @media (hover: hover) {
        .modal-body::-webkit-scrollbar-thumb:hover {
          background: rgba(56, 189, 248, 0.45);
        }
      }
    }

    html {
      /* scrollbar-width: thin; */
      /* scrollbar-color: rgba(56, 189, 248, 0.5) rgba(8, 13, 26, 0.9); */
    }

    @media (max-width: 860px) {
      .hero-grid {
        grid-template-columns: 1fr;
      }

      .use-cases {
        grid-template-columns: repeat(2, 1fr);
      }

      .masonry-wall {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 680px) {
      .header-actions .btn-ghost span {
        display: none;
      }

      .header-actions .btn-ghost {
        padding: 8px 10px;
      }

      .header-actions .home-btn svg {
        width: 14px;
        height: 14px;
      }
    }

    @media (max-width: 630px){
      .modal-glass {
        max-height: 100dvh;
      }
      .modal-overlay {
        padding: 0px;
      }
    }

    @media (max-width: 560px) {
      .header-inner {
        padding: 0 16px;
      }

      .hero {
        min-height: auto;
        /* padding-top: 46px; */
        padding-top: 32px;
      }

      .use-cases {
        grid-template-columns: 1fr;
      }

      .masonry-wall {
        grid-template-columns: 1fr;
      }
    }

    /* ── Breadcrumb ── */
    .breadcrumb {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: var(--surface-1);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 6px 18px;
      font-size: 14px;
      max-width: 100%;
      overflow-x: auto;
      scrollbar-width: none;
      margin-bottom: 18px;
    }

    .breadcrumb::-webkit-scrollbar {
      display: none;
    }

    .breadcrumb .crumb {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      text-decoration: none;
      font-weight: 600;
      white-space: nowrap;
      transition: color 150ms ease;
    }

    .breadcrumb .crumb svg {
      flex-shrink: 0;
    }

    .breadcrumb .crumb-explore {
      color: #a78bfa;
    }
    @media (hover: hover) {
      .breadcrumb a.crumb-explore:hover {
        color: #c4b5fd;
      }
    }

    .breadcrumb .crumb-dashboard {
      color: var(--text-2);
    }
    @media (hover: hover) {
      .breadcrumb a.crumb-dashboard:hover {
        color: var(--text);
      }
    }
    .breadcrumb .crumb-dashboard.crumb-current {
      color: var(--text);
    }

    .breadcrumb .crumb-sep {
      color: var(--text-3);
      opacity: 0.55;
      flex-shrink: 0;
    }

    @media (max-width: 560px) {
      .toast {
        min-width: auto;
        width: calc(100vw - 32px);
      }

      .toast-container {
        right: 16px;
        bottom: 16px;
        left: 16px;
      }

      .breadcrumb {
        font-size: 12px;
        padding: 6px 10px;
      }
    }

    #public-notes {
      scroll-margin-top: 84px;
      /* 68px navbar + ~16px breathing room */
    }

    /* Small mobile */
    @media (max-width: 420px) {
      .brand-title {
        font-size: 1.05rem;
      }
    }
  </style>
</head>

<body>
  <header class="site-header">
    <div class="header-inner">
      <a href="/" class="header-brand">
        <span class="brand-pulse" aria-hidden="true"></span>
        <span class="brand-title">Share<em>Info</em></span>
      </a>
      <nav class="header-actions">
        <% if (isLoggedIn) { %>
        <a class="btn btn-ghost home-btn" href="/">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="position: relative;top: -2px;">
            <path d="M12 3.2 3.5 10a1 1 0 0 0-.4.8V20a2 2 0 0 0 2 2h4v-6h6v6h4a2 2 0 0 0 2-2v-9.2a1 1 0 0 0-.4-.8L12 3.2Z"></path>
