        if (isLong) {
          card.setAttribute('role', 'button');
          card.tabIndex = 0;
          card.setAttribute('aria-label', `View full content for ${name}`);
        } else {
          card.removeAttribute('role');
          card.removeAttribute('tabindex');
          card.removeAttribute('aria-label');
        }

        card.classList.remove('card-pending');  // TEMP: skeleton stays for inspection
      }

      async function copyToClipboard(text) {
        if (navigator.clipboard && window.isSecureContext) {
          return navigator.clipboard.writeText(text);
        }

        const textarea = document.createElement('textarea');
        textarea.value = text;
        textarea.style.position = 'fixed';
        textarea.style.left = '-9999px';
        document.body.appendChild(textarea);
        textarea.select();

        try {
          document.execCommand('copy');
        } finally {
          textarea.remove();
        }
      }

      function canUseNativeShare(text) {
        if (!navigator.share) return false;
        if (!window.matchMedia('(pointer: coarse)').matches) return false;
        if (navigator.canShare && !navigator.canShare({ text })) return false;
        return true;
      }

      async function shareText(text, id, shortId) {
        const link = shortId
          ? `${window.location.origin}/e/${encodeURIComponent(shortId)}`
          : `${window.location.origin}/entry/${encodeURIComponent(id)}`;

        try {
          await copyToClipboard(link);
        } catch (err) {
          console.error('Failed to copy link:', err);
          showToast('Failed to copy link', 'error');
          return;
        }

        if (!canUseNativeShare(text)) {
          showToast('Link copied to clipboard');
          return;
        }

        try {
          await navigator.share({ text: `${text}\n\n━━━━━━━━━━━━━━━━━━━\n\n🌐 Link:\n${link}` });
          showToast('Shared');
        } catch (err) {
          if (err.name === 'AbortError') return;
          console.error('Share failed:', err);
          showToast('Share failed. Link copied to clipboard.');
        }
      }

