      async function toggleFavorite(button) {
        const card = button?.closest('.info-card');
        const id = card?.dataset.id || card?.id;
        if (!card || !id || button.dataset.loading === 'true') return;

        const previous = card.dataset.isFavorite === 'true';
        const next = !previous;
        button.dataset.loading = 'true';
        applyFavoriteState(card, next, next, false);

        try {
          const response = await fetch(`/api/entries/${encodeURIComponent(id)}/favorite`, {
            method: 'PATCH',
            headers: { Accept: 'application/json' },
          });

          if (response.status === 401) {
            window.location.href = '/login';
            return;
          }

          if (!response.ok) throw new Error('Favorite request failed');
          const result = await response.json();
          applyFavoriteState(card, result.isFavorite === true);
          showToast(result.isFavorite ? 'Added to favorites' : 'Removed from favorites');
        } catch (err) {
          console.error('Failed to update favorite:', err);
          applyFavoriteState(card, previous);
          showToast('Failed to update favorite', 'error');
        } finally {
          button.dataset.loading = 'false';
        }
      }

