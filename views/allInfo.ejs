      function shouldShowInCurrentFilter(item) {
        if (type === 'master' || isAdminUser) {
          if (activeVisibility === 'favorite') return item.isFavorite === true;
          if (activeVisibility === 'public') return item.isPublic === true;
          if (activeVisibility === 'private') return item.isPublic !== true;
          return true;
        }
        const isOwn = item.email === currentUserEmail;
        if (activeVisibility === 'private') return isOwn && item.isPublic !== true;
        if (activeVisibility === 'favorite') return isOwn && item.isFavorite === true;
        if (activeVisibility === 'public') return item.isPublic === true;
        const folderMatch = !activeFolderId || item.folderId === activeFolderId;
        return isOwn && folderMatch;
      }

      function applyLongCardState(card, isLong) {
        if (!card) return;

        const name = card.dataset.name || '';
        const info = card.dataset.info || '';
        const email = card.dataset.email || '';
        const password = card.dataset.password || '';
        const isPublic = card.dataset.isPublic === 'true';
        const typeStrip = card.querySelector('.card-type-strip');
        const text = card.querySelector('.card-text');
        const viewMoreButton = card.querySelector('.view-more-btn');

        card.classList.toggle('card-long', isLong);
        card.classList.toggle('card-plain', !isLong);

        if (typeStrip) {
          typeStrip.innerHTML = '';
          appendStaticIcon(typeStrip, isLong ? `
            <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="17" y1="10" x2="3" y2="10"></line>
              <line x1="21" y1="6" x2="3" y2="6"></line>
              <line x1="21" y1="14" x2="3" y2="14"></line>
              <line x1="17" y1="18" x2="3" y2="18"></line>
            </svg>
          ` : `
            <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
            </svg>
          `);
          typeStrip.append(document.createTextNode(`${isLong ? ' Note' : ' Data'} / ${isPublic ? 'Public' : 'Private'}`));
        }

        if (text) {
          text.classList.toggle('card-text-snippet', isLong);
          const ellipsis = text.querySelector('.ellipsis-fade');

          if (isLong && !ellipsis) {
            const ellipsisNode = document.createElement('span');
            ellipsisNode.className = 'ellipsis-fade';
            ellipsisNode.textContent = '\u2026';
            text.append(ellipsisNode);
          } else if (!isLong && ellipsis) {
            ellipsis.remove();
          }
        }

        if (viewMoreButton) {
          viewMoreButton.hidden = !isLong;
