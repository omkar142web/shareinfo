      function applyFavoriteState(card, isFavorite, animate = false, allowFilterRemoval = true) {
        if (!card) return;
        card.dataset.isFavorite = isFavorite ? 'true' : 'false';
        setFavoriteButtonState(card.querySelector('.card-favorite-icon'), isFavorite, animate);

        if (allowFilterRemoval && activeVisibility === 'favorite' && !isFavorite) {
          card.classList.add('is-removing');
          setTimeout(() => {
