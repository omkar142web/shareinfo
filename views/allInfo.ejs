    <!-- ── Color Picker Modal ── -->
    <div class="modal-overlay" id="colorPickerModal" role="dialog" aria-modal="true" hidden>
      <div class="modal-glass" style="max-width: 280px;">
        <div class="modal-header">
          <h3 class="modal-name">Change Color</h3>
          <button class="modal-close" id="colorPickerModalClose" aria-label="Close">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>
        <div class="modal-divider"></div>
        <div class="modal-body" style="display:flex;gap:10px;justify-content:center;padding:16px;">
          <button class="color-swatch" data-color="blue" style="background:var(--folder-blue)" aria-label="Blue"></button>
          <button class="color-swatch" data-color="purple" style="background:var(--folder-purple)" aria-label="Purple"></button>
          <button class="color-swatch" data-color="green" style="background:var(--folder-green)" aria-label="Green"></button>
          <button class="color-swatch" data-color="red" style="background:var(--folder-red)" aria-label="Red"></button>
          <button class="color-swatch" data-color="orange" style="background:var(--folder-orange)" aria-label="Orange"></button>
          <button class="color-swatch" data-color="pink" style="background:var(--folder-pink)" aria-label="Pink"></button>
        </div>
      </div>
    </div>

    <!-- ── Toast Container ── -->
    <div class="toast-container" id="toastContainer" aria-live="polite" aria-atomic="true"></div>
    <button id="backToTop" aria-label="Back to top">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m18 15-6-6-6 6" />
      </svg>
    </button>

    <script src="/socket.io/socket.io.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/dompurify@3.2.3/dist/purify.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/marked@15.0.6/marked.min.js"></script>
    <script src="/js/linkify-it.bundle.js"></script>
    <script src="/js/markdown-renderer.js"></script>
    <script>
      const initialPagination = {
        nextCursor: <%- JSON.stringify(typeof initialCursor !== "undefined" ? initialCursor : null) %>,
        hasMore: <%= typeof hasMore !== "undefined" ? Boolean(hasMore) : false %>,
        totalCount: <%= typeof totalCount !== "undefined" ? totalCount : (typeof data !== "undefined" ? data.length : 0) %>
      };
      let nextCursor = initialPagination.nextCursor;
      let totalEntryCount = initialPagination.totalCount;
      let isFetching = false;
      let isAutoLoading = false;
      let exhausted = !initialPagination.hasMore;
      let observer;
      let activeVisibility = '<%= activeVisibility || "all" %>';
      const currentUserEmail = <%- JSON.stringify(typeof currentUserEmail !== "undefined" ? currentUserEmail : "") %>;
      const isAdminUser = <%= typeof isAdmin !== "undefined" ? Boolean(isAdmin) : false %>;
      let searchKeyword = <%- JSON.stringify(typeof activeKeyword !== "undefined" ? activeKeyword : "") %>;
      let currentSort = '<%= typeof activeSort !== "undefined" ? activeSort : "updated" %>';
      // Mutable: enterFolderView() (inline folder create) switches it in place
      let activeFolderId = <%- JSON.stringify(typeof activeFolderId !== "undefined" ? activeFolderId : null) %>;

      function escapeHTML(value = '') {
        return String(value).replace(/[&<>"']/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch]));
      }

      const wall = document.getElementById('masonryWall');
      document.querySelectorAll('.info-card .card-text.md-content').forEach(function (el) {
        var info = (el.closest('.info-card') || {}).dataset || {};
        renderMarkdownInto(el, (info.info || '').replace(/\\n/g, '\n'));
      });
      requestAnimationFrame(function () { refreshCardOverflowState(); });
      // Re-measure once when lazy-loaded highlight.js finishes (code blocks change height)
      let highlightReMeasureScheduled = false;
      document.addEventListener('markdown:highlighted', () => {
        if (highlightReMeasureScheduled) return;
        highlightReMeasureScheduled = true;
        requestAnimationFrame(() => {
          highlightReMeasureScheduled = false;
          refreshCardOverflowState();
        });
      });
      if (wall) {
        wall.addEventListener('click', (event) => {
          const card = event.target.closest('.info-card');
          if (!card) return;

          if (event.target.closest('.card-copy-icon')) {
            event.stopPropagation();
            copyCardContent(event.target.closest('.card-copy-icon'));
            return;
          }

          if (event.target.closest('.card-favorite-icon')) {
            event.stopPropagation();
            toggleFavorite(event.target.closest('.card-favorite-icon'));
            return;
          }

          if (event.target.closest('.view-more-btn')) {
            event.stopPropagation();
            openModal(card.dataset.name || '', card.dataset.info || '', card.dataset.email || '', card.dataset.password || '');
            return;
          }

          if (event.target.closest('.action-copy')) {
            event.stopPropagation();
            shareText((card.dataset.info || '').replace(/\\n/g, '\n'), card.dataset.id || card.id, card.dataset.shortId || '');
            return;
          }

          if (event.target.closest('.action-edit')) {
            event.stopPropagation();
            window.location.href = `update/${encodeURIComponent(card.dataset.shortId || card.dataset.id || card.id)}`;
            return;
          }

          if (event.target.closest('.action-delete')) {
            event.stopPropagation();
            DeleteFun(card.dataset.id || card.id, event.target.closest('.action-delete'));
            return;
          }

          if (card.classList.contains('card-long') && (event.target === card || event.target.closest('.card-body'))) {
            openModal(card.dataset.name || '', card.dataset.info || '', card.dataset.email || '', card.dataset.password || '');
          }
        });

        wall.addEventListener('keydown', (event) => {
          if (event.key !== 'Enter' && event.key !== ' ') return;
          const card = event.target.closest('.info-card');
          if (!card || !card.classList.contains('card-long')) return;
          if (event.target.closest('button') || event.target.closest('a')) return;
          event.preventDefault();
          openModal(card.dataset.name || '', card.dataset.info || '', card.dataset.email || '', card.dataset.password || '');
        });
      }

      /* ── Search + Sort Functions ── */

      function closeSortMenu() {
        const menu = document.getElementById('sortMenu');
        const toggle = document.getElementById('sortToggle');
        if (menu) menu.hidden = true;
        if (toggle) toggle.setAttribute('aria-expanded', 'false');
      }

      function openSortMenu() {
        const menu = document.getElementById('sortMenu');
        const toggle = document.getElementById('sortToggle');
        if (menu) menu.hidden = false;
        if (toggle) toggle.setAttribute('aria-expanded', 'true');
      }

      function setActiveSort(sort) {
        currentSort = sort === 'created' ? 'created' : 'updated';
        document.querySelectorAll('.sort-option').forEach((option) => {
          const isActive = option.dataset.sort === currentSort;
          option.classList.toggle('is-active', isActive);
          option.setAttribute('aria-checked', String(isActive));
        });
      }

      setActiveSort(currentSort);

      function setClearSearchVisibility(value) {
        const btn = document.getElementById('clearSearch');
        if (btn) btn.hidden = !value.trim();
      }

      function setupObserver() {
        const sentinel = document.getElementById('scroll-sentinel');
        if (!exhausted && nextCursor && sentinel) {
          if (observer) observer.disconnect();
          observer = new IntersectionObserver(
            ([entry]) => { if (entry.isIntersecting) loadMore(); },
            { rootMargin: '0px 0px 200px 0px' }
          );
          observer.observe(sentinel);
        }
      }

      function updateEmptyState(keyword = searchKeyword, visibility = activeVisibility) {
        const emptyState = document.getElementById('emptyState');
        const wall = document.getElementById('masonryWall');
        if (!emptyState || !wall) return;

        const hasCards = wall.querySelectorAll('.info-card').length > 0;
        if (hasCards) {
          emptyState.style.display = 'none';
          return;
        }

        const glyph = document.getElementById('emptyGlyph');
        const illustration = document.getElementById('emptyIllustration');
        const trimmedKey = (keyword || '').trim();
        const isSearchEmpty = !!trimmedKey;
        const isFilterEmpty = visibility && visibility !== 'all';

        if (glyph) glyph.style.display = (!isSearchEmpty && !isFilterEmpty) ? 'flex' : 'none';
        if (illustration) illustration.style.display = (isSearchEmpty || isFilterEmpty) ? 'flex' : 'none';

        emptyState.style.display = 'flex';
        emptyState.classList.remove('empty-animate');
        void emptyState.offsetWidth;
        emptyState.classList.add('empty-animate');

        const titleEl = emptyState.querySelector('.empty-title');
        const descEl = emptyState.querySelector('.empty-desc');
        const actionWrap = emptyState.querySelector('.empty-action-wrap');

        const truncatedKey = trimmedKey.length > 60 ? trimmedKey.slice(0, 60) + '\u2026' : trimmedKey;

        if (trimmedKey) {
          if (titleEl) titleEl.textContent = 'No results found';
          if (descEl) {
            descEl.innerHTML = `We couldn't find any entries matching<br><span class="query">"${escapeHTML(truncatedKey)}"</span>`;
          }
          if (actionWrap) {
            actionWrap.innerHTML = `
              <button class="btn-retry" type="button" id="emptyRetryBtn">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" /></svg> Try a different search
              </button>
            `;
          }
        } else if (visibility && visibility !== 'all') {
          const visName = visibility.charAt(0).toUpperCase() + visibility.slice(1);
          if (titleEl) titleEl.textContent = `No ${visName} entries`;
          if (descEl) {
            descEl.innerHTML = `You don't have any <span class="query">${escapeHTML(visibility)}</span> entries saved yet.`;
          }
          if (actionWrap) {
            actionWrap.innerHTML = `
              <button class="btn-retry" type="button" id="emptyRetryBtn">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16l-6 8v5l-4 2v-7z" /><path d="M3 3l18 18" /></svg> Show all entries
              </button>
            `;
            document.getElementById('emptyRetryBtn')?.addEventListener('click', () => {
              const filterAllBtn = document.querySelector('.filter-btn[data-filter="all"]');
              if (filterAllBtn) filterAllBtn.click();
              else {
                window.location.href = '/';
              }
            });
          }
        } else {
          if (titleEl) titleEl.textContent = 'Your wall is empty';
          if (descEl) descEl.textContent = 'Start building your personal info wall. Add links, notes, and data you want to keep.';
          if (actionWrap) {
            actionWrap.innerHTML = `
              <button class="btn-primary" type="button" onclick="window.location.href='/add'">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14" /><path d="M5 12h14" /></svg> Add your first entry
              </button>
            `;
          }
        }
      }

      async function runSearch(keyword) {
        searchKeyword = keyword.trim();
        try {
          const params = new URLSearchParams({ limit: '20', sort: currentSort });
          if (searchKeyword) params.set('keyword', searchKeyword);
          if (activeVisibility !== 'all') params.set('visibility', activeVisibility);
          if (activeFolderId) params.set('folderId', activeFolderId);
          const response = await fetch(`/api/entries?${params}`, { headers: { Accept: 'application/json' } });
          if (response.status === 401) { window.location.href = '/login'; return; }
          if (!response.ok) throw new Error('Search request failed');
          const page = await response.json();
          if (typeof page.totalCount === 'number') {
            totalEntryCount = page.totalCount;
          }
          const wall = document.getElementById('masonryWall');
          if (wall) {
            wall.textContent = '';
            wall.style.display = '';
            if (page.items?.length) {
              wall.append(renderCards(page.items));
              refreshCardOverflowState(wall);
              updateAllCardBadges();
            }
          }
          updateEmptyState(searchKeyword, activeVisibility);
          nextCursor = page.nextCursor || null;
          exhausted = !page.hasMore || !nextCursor;
          if (exhausted) finishFeed();
          else { const eof = document.getElementById('end-of-feed'); if (eof) eof.hidden = true; }
          setupObserver();
          setClearSearchVisibility(searchKeyword);
        } catch (err) {
          console.error('Search failed:', err);
          showToast('Search failed', 'error');
        }
      }

      let searchTimer;

      document.getElementById('searchForm')?.addEventListener('submit', (event) => { event.preventDefault(); });

      document.getElementById('searchInput')?.addEventListener('input', (event) => {
        setClearSearchVisibility(event.target.value);
        clearTimeout(searchTimer);
        searchTimer = setTimeout(() => { runSearch(event.target.value); }, 500);
      });

      document.getElementById('clearSearch')?.addEventListener('click', () => {
        clearTimeout(searchTimer);
        const input = document.getElementById('searchInput');
        if (input) {
          input.value = '';
          input.focus({ preventScroll: true });
        }
        setClearSearchVisibility('');
        runSearch('');
      });

      document.addEventListener('click', (event) => {
        if (event.target.closest('#emptyRetryBtn')) {
          const input = document.getElementById('searchInput');
          if (input) {
            input.value = '';
            input.focus({ preventScroll: true });
          }
          setClearSearchVisibility('');
          runSearch('');
        }
      });

      document.getElementById('sortToggle')?.addEventListener('click', () => {
        const menu = document.getElementById('sortMenu');
        if (menu) {
          if (menu.hidden) openSortMenu();
          else closeSortMenu();
        }
      });

      document.querySelectorAll('.sort-option').forEach((option) => {
        option.addEventListener('click', () => {
          const nextSort = option.dataset.sort || 'updated';
          closeSortMenu();
          if (nextSort === currentSort) return;
          setActiveSort(nextSort);
          clearTimeout(searchTimer);
          const input = document.getElementById('searchInput');
          runSearch(input ? input.value : '');
        });
      });

      document.addEventListener('click', (event) => {
        const menu = document.getElementById('sortMenu');
        if (!menu || menu.hidden) return;
        if (event.target.closest('.sort-wrap')) return;
        closeSortMenu();
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          const menu = document.getElementById('sortMenu');
          if (menu && !menu.hidden) {
            closeSortMenu();
            return;
          }
          const searchInput = document.getElementById('searchInput');
          if (searchInput && (searchInput.value.trim() !== '' || document.activeElement === searchInput)) {
            searchInput.value = '';
            setClearSearchVisibility('');
            searchInput.blur();
            runSearch('');
          }
        }
      });

      /* ── Modern Deletion & Feedback Logic ── */
      let type = document.body.dataset.type;
      let deleteTarget = {
        id: null,
        btn: null
      };
      const confirmOverlay = document.getElementById('confirmOverlay');
      const confirmDeleteBtn = document.getElementById('confirmDeleteBtn');
      const toastContainer = document.getElementById('toastContainer');
      const backToTop = document.getElementById('backToTop');
      if (backToTop) {
        window.addEventListener('scroll', () => {
          backToTop.classList.toggle('show', window.scrollY > window.innerHeight * 0.5);
        });
        backToTop.addEventListener('click', () => {
          window.scrollTo({
            top: 0,
            behavior: 'smooth'
          });
        });
      }
      const overlayState = new WeakMap();
      const scrollLocks = new Set();
      let originalBodyOverflow = '';
      let originalBodyPaddingRight = '';

      function lockPageScroll(owner) {
        if (scrollLocks.has(owner)) return;

        if (scrollLocks.size === 0) {
          originalBodyOverflow = document.body.style.overflow;
          originalBodyPaddingRight = document.body.style.paddingRight;

          const scrollBarWidth = window.innerWidth - document.documentElement.clientWidth;
          const bodyPaddingRight = parseFloat(getComputedStyle(document.body).paddingRight) || 0;
          document.body.style.overflow = 'hidden';

          if (scrollBarWidth > 0) {
            document.body.style.paddingRight = `${bodyPaddingRight + scrollBarWidth}px`;
          }
        }

        scrollLocks.add(owner);
      }

      function unlockPageScroll(owner) {
        scrollLocks.delete(owner);
        if (scrollLocks.size > 0) return;

        document.body.style.overflow = originalBodyOverflow;
        document.body.style.paddingRight = originalBodyPaddingRight;
      }

      function getOverlayState(element) {
        if (!overlayState.has(element)) {
          overlayState.set(element, {
            closeTimer: null,
            openFrame: null,
            returnFocus: null,
            activeClass: null,
            onClosed: null,
            restoreFocus: true
          });
        }

        return overlayState.get(element);
      }

      const MODAL_HISTORY_STATE_KEY = 'shareInfoModal';
      let modalHistoryCount = 0;

      function getActiveOverlay() {
        // Topmost overlay first — add future modals here in stacking order.
        if (confirmOverlay && !confirmOverlay.hidden) return confirmOverlay;
        const folderDeleteModal = document.getElementById('folderDeleteModal');
        if (folderDeleteModal && !folderDeleteModal.hidden) return folderDeleteModal;
        if (overlay && !overlay.hidden) return overlay;
        const folderModal = document.getElementById('folderModal');
        if (folderModal && !folderModal.hidden) return folderModal;
        const renameFolderModal = document.getElementById('renameFolderModal');
        if (renameFolderModal && !renameFolderModal.hidden) return renameFolderModal;
        const colorPickerModal = document.getElementById('colorPickerModal');
        if (colorPickerModal && !colorPickerModal.hidden) return colorPickerModal;
        const folderDropdown = document.getElementById('folderDropdown');
        if (folderDropdown && !folderDropdown.hidden) return folderDropdown;
        return null;
      }

      function pushModalHistory() {
        history.pushState({
          [MODAL_HISTORY_STATE_KEY]: modalHistoryCount
        }, '');
        modalHistoryCount++;
      }

      function openOverlay(element, activeClass, focusTarget, returnFocus = document.activeElement) {
        const state = getOverlayState(element);
        clearTimeout(state.closeTimer);
        cancelAnimationFrame(state.openFrame);
        state.closeTimer = null;
        state.returnFocus = returnFocus;
        state.activeClass = activeClass;
        state.onClosed = null;
        state.restoreFocus = true;

        lockPageScroll(element);
        element.hidden = false;
        element.setAttribute('aria-hidden', 'false');
        pushModalHistory();

        state.openFrame = requestAnimationFrame(() => {
          element.classList.add(activeClass);
          focusTarget?.focus({ preventScroll: true });
          state.openFrame = null;
        });
      }

      function closeOverlay(element, activeClass, onClosed, restoreFocus = true, {
        fromPopstate = false
      } = {}) {
        if (element.hidden) return;

        const state = getOverlayState(element);

        if (!fromPopstate) {
          if (activeClass) state.activeClass = activeClass;
          if (onClosed) state.onClosed = onClosed;
          state.restoreFocus = restoreFocus;

          if (modalHistoryCount > 0) {
            history.back();
            return;
          }
        }

        const activeClassName = state.activeClass || activeClass;
        const closedCallback = state.onClosed || onClosed;
        const shouldRestoreFocus = fromPopstate ? state.restoreFocus : restoreFocus;

        clearTimeout(state.closeTimer);
        cancelAnimationFrame(state.openFrame);
        state.openFrame = null;
        element.classList.remove(activeClassName);

        state.closeTimer = setTimeout(() => {
          element.hidden = true;
          element.setAttribute('aria-hidden', 'true');
          unlockPageScroll(element);
          closedCallback?.();

          if (shouldRestoreFocus && state.returnFocus?.isConnected) {
            state.returnFocus.focus({ preventScroll: true });
          }

          state.returnFocus = null;
          state.onClosed = null;
          state.closeTimer = null;
        }, 300);
      }

      window.addEventListener('popstate', () => {
        const activeElement = getActiveOverlay();
        if (activeElement) {
          if (activeElement.id === 'folderDropdown') {
            if (modalHistoryCount > 0) modalHistoryCount--;
            closeFolderDropdown();
            return;
          }

          if (modalHistoryCount <= 0) return;
          modalHistoryCount--;
          closeOverlay(activeElement, null, null, true, {
            fromPopstate: true
          });
          return;
        }

        // Handle folder and visibility navigation via back/forward buttons
        const params = new URLSearchParams(window.location.search);
        const rawFolderId = params.get('folderId');
        let folderId = rawFolderId && /^[a-f\d]{24}$/i.test(rawFolderId) ? rawFolderId : null;
        // If not a valid ObjectId, try resolving as a shortId via folderData
        if (!folderId && rawFolderId) {
          const match = (window.folderData || []).find(f => f.shortId === rawFolderId);
          if (match) folderId = match.id;
        }
        const rawVisibility = params.get('visibility');
        const visibility = ['public', 'private', 'favorite'].includes(rawVisibility) ? rawVisibility : 'all';

        const folderChanged = folderId !== activeFolderId;
        const visibilityChanged = visibility !== activeVisibility;

        if (!folderChanged && !visibilityChanged) return;

        if (folderChanged) {
          activeFolderId = folderId;
          const folder = (window.folderData || []).find(f => f.id === folderId);
          const folderName = folder ? folder.name : '';
          const folderColor = folder ? folder.color : 'blue';

          if (folderName) {
            updateActiveFolderDisplay(folderName, folderColor);
          } else {
            const current = document.getElementById('folderSelectorCurrent');
            if (current) current.textContent = 'All';

            const crumb = document.querySelector('.breadcrumb');
            if (crumb) {
              const dashboardLink = crumb.querySelector('a[href="/"]');
              const currentSpan = crumb.querySelector('.current');
              if (currentSpan && currentSpan.querySelector('.folder-dot')) {
                const sep = currentSpan.previousElementSibling;
                if (sep && sep.classList.contains('sep')) {
                  sep.remove();
                }
                currentSpan.remove();
                if (dashboardLink) dashboardLink.classList.add('current');
              } else if (currentSpan && currentSpan.tagName === 'A') {
                currentSpan.classList.add('current');
              }
            }
          }

          (window.folderData || []).forEach(f => { f.isActive = f.id === folderId; });
          window.refreshFolderDropdown && window.refreshFolderDropdown();
        }

        if (visibilityChanged) {
          activeVisibility = visibility;
          document.querySelectorAll('.filter-btn').forEach((btn) => {
            btn.classList.toggle('active', btn.dataset.filter === visibility);
          });
        }

        const input = document.getElementById('searchInput');
        runSearch(input ? input.value : '');
      });

      function resetConfirmButton() {
        confirmDeleteBtn.disabled = false;
        confirmDeleteBtn.innerHTML = '<span>Delete</span>';
