            <path d="M11.5 2.9l2.8 5.7 6.3.9-4.6 4.5 1.1 6.3-5.6-2.9-5.6 2.9 1.1-6.3-4.6-4.5 6.3-.9 2.8-5.7z"></path>
          </svg>
