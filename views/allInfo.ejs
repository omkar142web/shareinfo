                <line x1="94.5" y1="78.5" x2="104" y2="88" stroke="url(#folderEmptyGrad)" stroke-width="4" stroke-linecap="round"></line>
              </g>
            </svg>
            <span class="folder-empty-title">No folders found</span>
            <!-- <span>Try a different search or create a new folder</span> -->
