                <line x1="28" y1="64" x2="58" y2="64" stroke="#7dd3fc" stroke-width="2.4" stroke-linecap="round" opacity="0.3"></line>
                <line x1="28" y1="76" x2="64" y2="76" stroke="#7dd3fc" stroke-width="2.4" stroke-linecap="round" opacity="0.2"></line>

